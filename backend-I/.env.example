# ==========================================
# SkillShare Backend — Environment Variables
# Copy this file to ".env" and fill in REAL values locally.
# NEVER commit the real .env file to Git.
# ==========================================
#chaman=====================================================================================tu

# PostgreSQL connection string (local or Neon).
# Local example:      postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/skillshare
# Neon example:       postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT signing secret. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# JWT algorithm
ALGORITHM=HS256

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Main admin identity (notification recipient + bootstrap seed).
# Authority still comes from users.role == "admin" in the database.
MAIN_ADMIN_EMAIL=daniket797@gmail.com

# SMTP for admin-request notification emails (Gmail app-password recommended).
# Leave blank locally — requests are still stored as pending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Allowed frontend origins for CORS (comma-separated). Used in production (e.g. Vercel URL).
# Leave empty for local development (localhost origins are always allowed).
FRONTEND_URL=http://localhost:5500

# Set to "production" on Render/Vercel — makes missing required
# variables fail loudly instead of falling back to local defaults.
# Leave unset (or "development") locally.
# ENVIRONMENT=development
